{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "io.github.jbrick2070.fadester-for-obs.obs-neo-infobar",
  "controller": "Neo",
  "items": [
    { "key": "border", "type": "text", "rect": [0, 0, 232, 50], "background": "#9146FF", "zOrder": 0 },
    { "key": "background", "type": "text", "rect": [2, 2, 228, 46], "background": "#08070B", "zOrder": 1 },
    { "key": "status", "type": "text", "rect": [6, 3, 220, 11], "alignment": "left", "font": { "size": 10 }, "color": "#FFF04B", "text-overflow": "ellipsis", "zOrder": 2 },
    { "key": "live", "type": "text", "rect": [6, 14, 220, 16], "alignment": "left", "font": { "size": 13, "weight": 600 }, "color": "#EF4444", "text-overflow": "ellipsis", "zOrder": 2 },
    { "key": "preview", "type": "text", "rect": [6, 30, 220, 17], "alignment": "left", "font": { "size": 13, "weight": 600 }, "color": "#22C55E", "text-overflow": "ellipsis", "zOrder": 2 }
  ]
}
