{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Fadester for OBS",
  "Version": "0.9.0.0",
  "Author": "Jeffrey A. Brick",
  "Description": "Direct OBS source browsing, show/hide, scenes, transitions, mixer fades, and optional creative layer controls. Midi Fadester integration is optional.",
  "Category": "Fadester for OBS",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/plugin-icon",
  "URL": "https://github.com/jbrick2070/streamdeck-fadester",
  "UUID": "com.jbrick2070.fadester-for-obs",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.6"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "Profiles": [
    {
      "Name": "profiles/plus-source-desk-v3",
      "DeviceType": 7,
      "Readonly": false,
      "AutoInstall": false,
      "DontAutoSwitchWhenInstalled": true
    },
    {
      "Name": "profiles/plus-source-half-v2",
      "DeviceType": 7,
      "Readonly": false,
      "AutoInstall": false,
      "DontAutoSwitchWhenInstalled": true
    },
    {
      "Name": "profiles/plus-creative-layer-lab-v2",
      "DeviceType": 7,
      "Readonly": false,
      "AutoInstall": false,
      "DontAutoSwitchWhenInstalled": true
    },
    {
      "Name": "profiles/buttons-source-desk-v4",
      "DeviceType": 0,
      "Readonly": false,
      "AutoInstall": false,
      "DontAutoSwitchWhenInstalled": true
    },
    {
      "Name": "profiles/buttons-source-half-v2",
      "DeviceType": 0,
      "Readonly": false,
      "AutoInstall": false,
      "DontAutoSwitchWhenInstalled": true
    },
    {
      "Name": "profiles/mini-source-desk-v2",
      "DeviceType": 1,
      "Readonly": false,
      "AutoInstall": false,
      "DontAutoSwitchWhenInstalled": true
    },
    {
      "Name": "profiles/plus-scene-desk-v2",
      "DeviceType": 7,
      "Readonly": false,
      "AutoInstall": false,
      "DontAutoSwitchWhenInstalled": true
    },
    {
      "Name": "profiles/buttons-creative-layer-lab-v2",
      "DeviceType": 0,
      "Readonly": false,
      "AutoInstall": false,
      "DontAutoSwitchWhenInstalled": true
    },
    {
      "Name": "profiles/buttons-scene-desk-v2",
      "DeviceType": 0,
      "Readonly": false,
      "AutoInstall": false,
      "DontAutoSwitchWhenInstalled": true
    },
    {
      "Name": "profiles/plus-scene-regular-v3",
      "DeviceType": 7,
      "Readonly": false,
      "AutoInstall": false,
      "DontAutoSwitchWhenInstalled": true
    },
    {
      "Name": "profiles/buttons-scene-regular-v2",
      "DeviceType": 0,
      "Readonly": false,
      "AutoInstall": false,
      "DontAutoSwitchWhenInstalled": true
    },
    {
      "Name": "profiles/plus-playlister-transport-v1",
      "DeviceType": 7,
      "Readonly": false,
      "AutoInstall": false,
      "DontAutoSwitchWhenInstalled": true
    },
    {
      "Name": "profiles/plus-vj-rig-v1",
      "DeviceType": 7,
      "Readonly": false,
      "AutoInstall": false,
      "DontAutoSwitchWhenInstalled": true
    },
    {
      "Name": "profiles/buttons-vj-rig-v1",
      "DeviceType": 0,
      "Readonly": false,
      "AutoInstall": false,
      "DontAutoSwitchWhenInstalled": true
    }
  ],
  "Actions": [
    {
      "Name": "OBS Scene Info Bar",
      "UUID": "com.jbrick2070.fadester-for-obs.obs-neo-infobar",
      "Icon": "imgs/actions/scene-transition/icon",
      "Tooltip": "Display OBS connection, live scene, and Studio Mode preview on the Stream Deck Neo Info Bar.",
      "PropertyInspectorPath": "ui/obs-neo-infobar.html",
      "Controllers": [
        "Neo"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/scene-transition/key"
        }
      ]
    },
    {
      "Name": "Source & Layer",
      "UUID": "com.jbrick2070.fadester-for-obs.layer-control",
      "Icon": "imgs/actions/source-layer/icon",
      "Tooltip": "Browse existing scene sources and show or hide the deck-selected source. Creative controls add blend modes and optional layer reordering.",
      "PropertyInspectorPath": "ui/obs-layer-control.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "Encoder": {
        "layout": "layouts/fader-cell.json",
        "TriggerDescription": {
          "Rotate": "Browse sources, blend modes, or explicitly enabled layer order",
          "Push": "Show/hide source, or reset blend to Normal",
          "Touch": "Show/hide source, or reset blend to Normal"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/source-layer/key"
        }
      ]
    },
    {
      "Name": "OBS Fader",
      "UUID": "com.jbrick2070.fadester-for-obs.obs-fader",
      "Icon": "imgs/actions/fader/icon",
      "Tooltip": "Adjust an audio source, or blend the Live scene into Next with the colorful scene mixer.",
      "PropertyInspectorPath": "ui/obs-fader-dial.html",
      "Controllers": [
        "Encoder"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "Encoder": {
        "layout": "layouts/fader-cell.json",
        "TriggerDescription": {
          "Rotate": "Adjust audio volume, or blend Live into Next",
          "Push": "Run the press action chosen in settings"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/fader/key"
        }
      ]
    },
    {
      "Name": "Scene & Transition",
      "UUID": "com.jbrick2070.fadester-for-obs.scene-transition",
      "Icon": "imgs/actions/scene-transition/icon",
      "Tooltip": "Select next or previous OBS scene, cut, preview, or run a chosen transition.",
      "PropertyInspectorPath": "ui/obs-scene-transition-key.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/actions/scene-transition/key"
        }
      ]
    },
    {
      "Name": "OBS Fade",
      "UUID": "com.jbrick2070.fadester-for-obs.obs-fade",
      "Icon": "imgs/actions/audio-fade/icon",
      "Tooltip": "Directly fade an OBS mixer input up or down without changing scene-transition settings.",
      "PropertyInspectorPath": "ui/obs-fade-key.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/actions/audio-fade/key"
        }
      ]
    },
    {
      "Name": "Playlister Transport",
      "UUID": "com.jbrick2070.fadester-for-obs.playlister-transport",
      "Icon": "imgs/actions/playlister-transport/icon",
      "Tooltip": "Previous, next, play/pause, stop, restart or status of one Playlister source through OBS's media controls.",
      "PropertyInspectorPath": "ui/playlister-transport-key.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/playlister-transport/key"
        }
      ]
    },
    {
      "Name": "OBS Filter",
      "UUID": "com.jbrick2070.fadester-for-obs.obs-filter",
      "Icon": "imgs/actions/obs-filter/icon",
      "Tooltip": "Ride a filter setting on a dial, or turn a filter on and off, set a value or step it from a key. Ranges, a gentle slew and ownership checks keep it safe.",
      "PropertyInspectorPath": "ui/obs-filter.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "Encoder": {
        "layout": "layouts/fader-cell.json",
        "TriggerDescription": {
          "Rotate": "Ride the filter setting",
          "Push": "Drop and return, or turn the filter on and off"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/obs-filter/key"
        }
      ]
    },
    {
      "Name": "Visual Panic",
      "UUID": "com.jbrick2070.fadester-for-obs.visual-panic",
      "Icon": "imgs/actions/visual-panic/icon",
      "Tooltip": "Visual Sidechain's Panic (instant) and Restore (hold 0.8 s), sent through OBS's own hotkeys. Panic keys show PANIC SENT until Restore.",
      "PropertyInspectorPath": "ui/visual-panic.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/visual-panic/key"
        }
      ]
    },
    {
      "Name": "Midi Fadester Fader (optional)",
      "UUID": "com.jbrick2070.fadester-for-obs.fader",
      "Icon": "imgs/actions/fader/icon",
      "Tooltip": "Optional enhanced control for an existing Midi Fadester slot.",
      "PropertyInspectorPath": "ui/fader-dial.html",
      "Controllers": [
        "Encoder"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "Encoder": {
        "layout": "layouts/fader-cell.json",
        "TriggerDescription": {
          "Rotate": "Nudge fader",
          "Push": "Run press action (hold 0.8 s for hold action)",
          "Touch": "Tap to jump or snap to side"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/fader/key"
        }
      ]
    },
    {
      "Name": "Midi Fadester Auto-fade (optional)",
      "UUID": "com.jbrick2070.fadester-for-obs.auto-fade",
      "Icon": "imgs/actions/auto-fade/icon",
      "Tooltip": "Optional enhanced fade for an existing Midi Fadester slot.",
      "PropertyInspectorPath": "ui/auto-fade-key.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/actions/auto-fade/key"
        }
      ]
    },
    {
      "Name": "VJster Speed",
      "UUID": "com.jbrick2070.fadester-for-obs.vjster-speed",
      "Icon": "imgs/actions/vjster-speed/icon",
      "Tooltip": "Turn for speed, hold and turn for fine steps, press for 1x, tap the strip to play or pause.",
      "PropertyInspectorPath": "ui/vjster/vjster.html",
      "Controllers": [
        "Encoder"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "Encoder": {
        "layout": "layouts/vjster-strip.json",
        "TriggerDescription": {
          "Rotate": "Speed (hold for fine steps)",
          "Push": "Back to 1x",
          "Touch": "Play or pause"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/vjster-speed/key"
        }
      ]
    },
    {
      "Name": "VJster Quality",
      "UUID": "com.jbrick2070.fadester-for-obs.vjster-quality",
      "Icon": "imgs/actions/vjster-quality/icon",
      "Tooltip": "Turn to step through the video's quality levels, press or tap for Auto. YouTube only.",
      "PropertyInspectorPath": "ui/vjster/vjster.html",
      "Controllers": [
        "Encoder"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "Encoder": {
        "layout": "layouts/vjster-strip.json",
        "TriggerDescription": {
          "Rotate": "Quality level",
          "Push": "Auto",
          "Touch": "Auto"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/vjster-quality/key"
        }
      ]
    },
    {
      "Name": "VJster Speed Preset",
      "UUID": "com.jbrick2070.fadester-for-obs.vjster-speed-preset",
      "Icon": "imgs/actions/vjster-speed-preset/icon",
      "Tooltip": "One fixed speed. Lights up while it is the speed playing.",
      "PropertyInspectorPath": "ui/vjster/vjster.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/actions/vjster-speed-preset/key"
        }
      ]
    },
    {
      "Name": "VJster Speed Step",
      "UUID": "com.jbrick2070.fadester-for-obs.vjster-speed-step",
      "Icon": "imgs/actions/vjster-speed-step/icon",
      "Tooltip": "Faster or slower by one step.",
      "PropertyInspectorPath": "ui/vjster/vjster.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/actions/vjster-speed-step/key"
        }
      ]
    },
    {
      "Name": "VJster Quality Preset",
      "UUID": "com.jbrick2070.fadester-for-obs.vjster-quality-preset",
      "Icon": "imgs/actions/vjster-quality-preset/icon",
      "Tooltip": "One fixed quality level, or Auto. Dimmed when the video does not offer it.",
      "PropertyInspectorPath": "ui/vjster/vjster.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/actions/vjster-quality-preset/key"
        }
      ]
    },
    {
      "Name": "VJster Pin Tab",
      "UUID": "com.jbrick2070.fadester-for-obs.vjster-pin",
      "Icon": "imgs/actions/vjster-pin/icon",
      "Tooltip": "Keep controlling the current Chrome tab, whatever else plays. Press again to let go.",
      "PropertyInspectorPath": "ui/vjster/vjster.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/vjster-pin/key"
        }
      ]
    },
    {
      "Name": "VJster Play / Pause",
      "UUID": "com.jbrick2070.fadester-for-obs.vjster-transport",
      "Icon": "imgs/actions/vjster-transport/icon",
      "Tooltip": "Play or pause the video.",
      "PropertyInspectorPath": "ui/vjster/vjster.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/actions/vjster-transport/key"
        }
      ]
    }
  ]
}