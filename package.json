{
  "name": "streamdeck-fadester",
  "version": "0.10.0",
  "description": "Fadester for OBS — direct OBS scene, transition, mixer-fade, and Stream Deck + fader controls with optional Midi Fadester integration",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "author": "Jeffrey A. Brick",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbrick2070/streamdeck-fadester.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build:profiles && rollup -c && npm run build:vjster && npm run build:suite",
    "build:suite": "node --import tsx scripts/suite/assemble.ts && rollup -c suite-plugin/rollup.config.mjs && node --import tsx scripts/suite/copy-vjster.ts",
    "suite:assemble": "node --import tsx scripts/suite/assemble.ts",
    "watch": "rollup -c -w",
    "opendeck:install": "node --import tsx scripts/opendeck/install.ts",
    "opendeck:parity": "node --import tsx scripts/opendeck/parity-run.ts",
    "build:profiles": "node --import tsx scripts/build-profiles.ts",
    "build:vjster": "npm run build:vjster-page && rollup -c vjster-plugin/rollup.config.mjs",
    "build:vjster-page": "rollup -c vjster-page/rollup.config.mjs",
    "test": "vitest run",
    "test:mutation": "node --import tsx scripts/run-mutation-checks.ts",
    "test:obs-live": "node --import tsx tests/obs-live-conformance.ts",
    "pi:harness": "node --import tsx scripts/pi-harness.ts",
    "validate": "streamdeck validate io.github.jbrick2070.fadester-for-obs.sdPlugin",
    "pack": "streamdeck pack io.github.jbrick2070.fadester-for-obs.sdPlugin --output release --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.3"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.3",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "rollup": "^4.40.0",
    "tslib": "^2.8.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
