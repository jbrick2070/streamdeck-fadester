{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": false,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "paths": {
      "streamdeck-fadester-shared": ["./packages/streamdeck-fadester-shared/src/index.ts"],
      "streamdeck-fadester-shared/obs": ["./packages/streamdeck-fadester-shared/src/obs/obs-vendor-client.ts"]
    }
  },
  "include": ["src/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
