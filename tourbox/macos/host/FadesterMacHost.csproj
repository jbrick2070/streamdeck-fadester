<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>FadesterMacHost</AssemblyName>
    <RootNamespace>Fadester.TourBox</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="CommandIngress.cs" />
    <Compile Include="HostSession.cs" />
    <Compile Include="HostSelfTests.cs" />
    <Compile Include="../native/MacNativeTBar.cs" Link="Native/MacNativeTBar.cs" />
    <Compile Include="../input/MacShortcutInput.cs" Link="Input/MacShortcutInput.cs" />
    <Compile Include="../../bridge/ActionNames.cs" Link="Shared/ActionNames.cs" />
    <Compile Include="../../bridge/AudioDesk.cs" Link="Shared/AudioDesk.cs" />
    <Compile Include="../../bridge/BridgeConfig.cs" Link="Shared/BridgeConfig.cs" />
    <Compile Include="../../bridge/DeskActions.cs" Link="Shared/DeskActions.cs" />
    <!-- The controller map is checked by BridgeConfig; XInput itself is only called by the Windows companion. -->
    <Compile Include="../../bridge/Gamepad.cs" Link="Shared/Gamepad.cs" />
    <Compile Include="../../bridge/MixDesk.cs" Link="Shared/MixDesk.cs" />
    <Compile Include="../../bridge/MixJournal.cs" Link="Shared/MixJournal.cs" />
    <Compile Include="../../bridge/MixProtocolServer.cs" Link="Shared/MixProtocolServer.cs" />
    <Compile Include="../../bridge/ObsConnection.cs" Link="Shared/ObsConnection.cs" />
    <Compile Include="../../bridge/StudioFader.cs" Link="Shared/StudioFader.cs" />
    <Compile Include="../../bridge/VjsterLink.cs" Link="Shared/VjsterLink.cs" />
    <Compile Include="../../bridge/VjsterDesk.cs" Link="Shared/VjsterDesk.cs" />
    <Compile Include="../../bridge/VjsterSelfTests.cs" Link="Tests/VjsterSelfTests.cs" />
    <Compile Include="../../bridge/BridgeSelfTests.cs" Link="Tests/BridgeSelfTests.cs" />
    <Compile Include="../../bridge/MixSelfTests.cs" Link="Tests/MixSelfTests.cs" />
    <Compile Include="../../tests/StudioFaderSelfTests.cs" Link="Tests/StudioFaderSelfTests.cs" />
    <Compile Include="../../tests/portable/ObsTransportChecks.cs" Link="Tests/ObsTransportChecks.cs" />
  </ItemGroup>
</Project>
